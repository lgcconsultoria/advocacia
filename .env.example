# Variáveis de ambiente lidas pelo projeto. Copie para `.env.local` e
# preencha com os valores reais — `.env.local` nunca é versionado.
#
# Nenhuma delas é obrigatória para rodar o site: cada uma é lida com um
# gate (`if (!id) return` ou `?? valorPadrão`), então a ausência de
# qualquer uma faz o recurso correspondente simplesmente não carregar, sem
# quebrar o build nem a navegação.

# --- Medição (components/analytics.tsx) -----------------------------------
# Cada provedor só é anexado ao DOM depois do consentimento do visitante
# (ver components/consent-banner.tsx). Sem a variável correspondente, o
# provedor nunca é anexado — nem sob consentimento.

# ID de métricas do Google Analytics 4 (formato "G-XXXXXXXXXX").
NEXT_PUBLIC_GA_ID=

# ID de projeto do Microsoft Clarity (mapa de calor / gravação de sessão).
NEXT_PUBLIC_CLARITY_ID=

# ID do Pixel da Meta (Facebook/Instagram Ads).
NEXT_PUBLIC_META_PIXEL_ID=

# --- SEO (app/layout.tsx) --------------------------------------------------
# Token de verificação de propriedade do Google Search Console. Configurado
# como variável de ambiente na Vercel (Settings → Environment Variables),
# não versionado, para poder trocar sem novo deploy de código.
GOOGLE_SITE_VERIFICATION=

# --- Integração com o back-end de materiais (lib/modelos.ts, ---------------
# --- components/modelo-form.tsx) -------------------------------------------
# URL base da API que serve os modelos/materiais gratuitos e recebe os
# leads capturados. Tem um valor padrão embutido no código
# (https://senturiao-os.vercel.app) — só precisa ser definida para apontar
# para outro ambiente (ex.: staging).
NEXT_PUBLIC_OS_URL=
